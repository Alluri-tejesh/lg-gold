{
  "name": "lg-gold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/sync-server-catalog.mjs && vite --port=3000 --host=0.0.0.0",
    "dev:api": "node server/dev.mjs",
    "dev:all": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev\"",
    "start": "node server/index.mjs",
    "admin:promote": "node server/promote-admin.mjs",
    "test:server": "node --test server/test/store.test.mjs",
    "pretest:server": "node scripts/sync-server-catalog.mjs",
    "build": "node scripts/sync-server-catalog.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check:data": "node scripts/check-data.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.21.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
