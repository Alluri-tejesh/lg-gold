# Server secrets only. Never prefix these variables with VITE_ or put them in frontend files.
MONGODB_URI=
MONGODB_DB=lg_gold
APP_ORIGIN=http://localhost:3000
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
# SMS OTP through Twilio Verify. Development writes simulated SMS to .local/mail when blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Email verification and password recovery. Development inbox when blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional gateway; direct UPI continues to require the mill to verify receipt.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
