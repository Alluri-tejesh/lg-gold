# Server secrets only. Never prefix these variables with VITE_ or put them in frontend files.
MONGODB_URI=
MONGODB_DB=lg_gold
APP_ORIGIN=http://localhost:3000
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=0
# Admin page sign-in (#admin). Change the password whenever you like and restart the server.
# Use at least 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: SMS sign-in codes through Twilio Verify. Blank = SMS option hidden on the live site;
# on your computer codes are printed in the npm run dev terminal instead of being sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional: email for password-reset links. Without it, customers ask the mill on WhatsApp and the admin page gives them a temporary password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional gateway; direct UPI continues to require the mill to verify receipt.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
